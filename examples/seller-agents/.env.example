# ─── Buyer (orchestrator) ────────────────────────────────────────────────────
# Wallet that pays the seller agents. Needs a little Fuji USDC.
# Get test USDC at https://faucet.circle.com (select Avalanche Fuji).
CHAINPE_PRIVATE_KEY=0x...

# ─── Sellers ─────────────────────────────────────────────────────────────────
# Each seller needs its OWN wallet (distinct from the buyer and each other) —
# ERC-8004 blocks self-feedback, so the buyer must differ from the sellers.
# *_PAYTO is the public address that receives USDC; *_PAYTO_KEY is its key
# (only needed to mint an identity / register on-chain).
RESEARCH_PAYTO=0x...
RESEARCH_PAYTO_KEY=0x...
DIGEST_PAYTO=0x...
DIGEST_PAYTO_KEY=0x...

# ERC-8004 agent ids — mint once with mint-identity.mjs, then paste here.
# The proxy advertises these on the 402 so buyers can rate without a registry scan.
RESEARCH_AGENT_ID=
DIGEST_AGENT_ID=

# ─── Shared ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Settlement: run an in-process facilitator with a funded gas key (AVAX),
# OR point at a hosted facilitator URL (Phase 4).
CHAINPE_FACILITATOR_KEY=0x...
# CHAINPE_FACILITATOR_URL=https://your-facilitator.example.com

# Network + deployed contracts (defaults shown; override if needed).
CHAINPE_NETWORK=fuji
CHAINPE_REGISTRY_ADDRESS=0x91677a35599f052E99Ed0ab9E45c17E736a22Bf6
ERC8004_IDENTITY_REGISTRY=0x56FEc2359fcDfFa6FA1D3a8AB3b708Ff698161D5
ERC8004_REPUTATION_REGISTRY=0x89476DfEf9c72a668fa5E86f154B73EDB053aFe4

# ─── Ports / pricing (optional) ──────────────────────────────────────────────
RESEARCH_PROXY_PORT=4501
RESEARCH_BACKEND_PORT=5101
RESEARCH_PRICE=0.01
DIGEST_PROXY_PORT=4502
DIGEST_BACKEND_PORT=5102
DIGEST_PRICE=0.01

# Optional model overrides.
# RESEARCH_MODEL=claude-sonnet-4-6
# DIGEST_MODEL=claude-haiku-4-5-20251001
